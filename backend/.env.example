PORT=3000
USE_IN_MEMORY_DB=false
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=campus_lost_found
ATLAS_MONGODB_URI=
# Optional: defaults to MONGODB_DATABASE when migrating to Atlas.
ATLAS_MONGODB_DATABASE=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PRIVATE_DATA_KEY=
PRIVATE_DATA_KEY_VERSION=v1
# A long random secret used as the admin bearer token in the POC.
ADMIN_API_TOKEN=
